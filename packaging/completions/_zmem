#compdef zmem

_zmem() {
    local context state state_descr line
    typeset -A opt_args
    local -a commands=(
        'status:Read daemon memory, Swap and pressure state' 'plan:Preview an independent policy decision'
        'doctor:Check system support' 'schema:Describe the AI interface'
        'run:Start a managed workload' 'daemon:Run the memory manager'
        'once:Evaluate one policy cycle' 'install:Install the system service'
        'rollback:Restore previous memory management'
    )
    if (( CURRENT == 2 )); then
        _arguments '(-h --help)'{-h,--help}'[Show help]' \
            '(-V --version)'{-V,--version}'[Show version]' '1:command:->command'
        [[ $state == command ]] && _describe 'command' commands
        return
    fi
    case $words[2] in
        status) _arguments '1:command:(status)' '--json[Emit structured status]' '--processes[Add current process usage]' '--live[Preview an independent sample without applying changes]' ;;
        plan|doctor) _arguments '1:command:(plan doctor)' '--json[Emit structured output]' ;;
        daemon) _arguments '1:command:(daemon)' '--observe[Observe without applying decisions]' '--config[Configuration file]:file:_files' ;;
        once) _arguments '1:command:(once)' '--apply[Apply the selected policy]' ;;
        install) _arguments '1:command:(install)' '--replace[Replace existing memory managers]' '--config[Initial configuration]:file:_files' ;;
        run)
            local -i boundary=${words[(i)--]}
            if (( boundary < CURRENT )); then
                shift boundary words
                (( CURRENT -= boundary ))
                _normal
            else
                local workload_class=background classes='background interactive disposable'
                local -i index dedup_selected=0
                for (( index=3; index < boundary && index <= $#words; ++index )); do
                    case $words[index] in
                        --class) (( ++index )); workload_class=${words[index]-} ;;
                        --max-memory) (( ++index )) ;;
                        --dedup) dedup_selected=1 ;;
                    esac
                done
                (( dedup_selected )) && classes='background disposable'
                local -a run_options=(
                    "--class[Workload policy]:class:($classes)"
                    '--max-memory[Hard memory limit in MiB]:MiB:'
                )
                if [[ $workload_class == (background|disposable) ]]; then
                    run_options+=('--dedup[Register a trusted job for system-wide KSM matching]')
                fi
                _arguments '1:command:(run)' "${run_options[@]}" '*:command:_command_names'
            fi ;;
    esac
}

_zmem "$@"
