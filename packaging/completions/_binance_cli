local -a words=("$words[@]") commands options arguments
local -a required_options optional_options boolean_options value_options
local -i CURRENT=$CURRENT index=2 help_mode=0 positional=0 literal=0
local route='' token candidate option flag label exclusion
local context state state_descr line curcontext="$curcontext"
typeset -A opt_args

_binance_cli_tree "$route"
while (( CURRENT > 2 && $#commands )); do
  token=$words[2]
  if [[ $token == help && $help_mode == 0 ]]; then
    help_mode=1
    shift 1 words
    (( --CURRENT ))
    continue
  fi
  # The parser also accepts the hidden profile select alias "change".
  [[ $route == profile && $token == change ]] && token=select
  candidate=${commands[(r)${token}:*]}
  [[ -n $candidate || ${commands[(Ie)$token]} -gt 0 ]] || break
  route="${route:+$route }$token"
  shift 1 words
  (( --CURRENT ))
  _binance_cli_tree "$route"
done

if (( help_mode )); then
  if (( $#commands )); then
    _describe -t commands 'command' commands
  else
    _message 'command help'
  fi
  return
fi

_binance_cli_parameters "$route"
options=('(- *)-h[Show help]' '(- *)--help[Show help]')
for option in "$required_options[@]"; do
  flag=${option#\*}
  label=${flag#--}
  label=${label//-/ }
  options+=("${option}[${label}]:${flag}:->value")
  value_options+=("$flag")
done
for option in "$optional_options[@]"; do
  flag=${option#\*}
  label=${flag#--}
  label=${label//-/ }
  options+=("${option}[${label}]::${flag}:->value")
done
for option in "$boolean_options[@]"; do
  case $option in
    -V|--version) exclusion='(- *)'; label='Show version' ;;
    -i|--interactive) exclusion='(-i --interactive)'; label='Interactive mode' ;;
    -f|--force) exclusion='(-f --force)'; label='Overwrite an existing profile' ;;
    *) exclusion=''; label=${${option#--}//-/ } ;;
  esac
  options+=("${exclusion}${option}[${label}]")
done

# Arbitrary request parameters consume the remaining tokens, including tokens
# that happen to spell a CLI option. Never reinterpret these as file names.
if [[ $route == request ]]; then
  while (( index < CURRENT )); do
    token=$words[index]
    if (( ! literal )); then
      case $token in
        --) literal=1; (( ++index )); continue ;;
        --profile|--time-unit) (( index += 2 )); continue ;;
        --profile=*|--time-unit=*|--signed|-h|--help)
          (( ++index )); continue ;;
      esac
    fi
    if (( positional >= 2 )); then
      _message 'request parameter'
      return
    fi
    (( ++positional, ++index ))
  done
fi

# Preserve the equals form accepted by clap without forcing equals when an
# option name itself is completed.
if [[ $PREFIX == --*=* ]] && (( ! literal )); then
  option=${PREFIX%%=*}
  if (( ${value_options[(Ie)$option]} || ${optional_options[(Ie)$option]} )); then
    state_descr=$option
    compset -P "${option}="
    if [[ "$route $state_descr" == 'profile create --api-secret' ]]; then
      case $PREFIX in
        /*|./*|../*|\~*) _files ;;
        *) _message 'API secret or private key path' ;;
      esac
    else
      _binance_cli_values "$route $state_descr" || _message "${state_descr#--}"
    fi
    return
  fi
fi

# clap accepts an optional boolean value as the following word. zsh otherwise
# treats that word as positional for a double-colon optional argument.
if (( CURRENT > 2 )) && [[ $PREFIX != -* ]] &&
   (( ${optional_options[(Ie)$words[CURRENT-1]]} )); then
  state_descr=$words[CURRENT-1]
  _binance_cli_values "$route $state_descr" || _message "${state_descr#--}"
  return
fi


case $route in
  completion) arguments=('1:shell:(bash elvish fish powershell zsh)' '*:argument:->text') ;;
  request) arguments=('1:HTTP method:(GET POST PUT DELETE)' '2:request URL:->text' '*:request parameter:->text') ;;
  *)
    if (( $#commands )); then
      arguments=('1:command:->command' '*:argument:->text')
    else
      arguments=('*:argument:->text')
    fi
    ;;
esac

# Keep a preceding required option value from becoming a spurious separator.
index=2
while (( index < CURRENT )); do
  [[ $words[index] == -- ]] && break
  if (( ${value_options[(Ie)$words[index]]} )); then
    if (( index + 1 < CURRENT )) && [[ $words[index+1] == -* ]]; then
      words[index+1]=__omztty_option_value__
    fi
    (( index += 2 ))
  else
    (( ++index ))
  fi
done

_arguments -C -S "$options[@]" "$arguments[@]"
case $state in
  command) _describe -t commands 'command' commands ;;
  value)
    if [[ "$route $state_descr" == 'profile create --api-secret' ]]; then
      case $PREFIX in
        /*|./*|../*|\~*) _files ;;
        *) _message 'API secret or private key path' ;;
      esac
    else
      _binance_cli_values "$route $state_descr" || _message "${state_descr#--}"
    fi
    ;;
  text) _message "$state_descr" ;;
esac
