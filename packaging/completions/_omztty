#compdef omztty

autoload -Uz _omztty_zdot _omztty_terminal

_omztty_completion() {
    local -a actions=('list:List command completion sources' 'check:Check source and executable fingerprints'
        'refresh:Validate and publish a local completion snapshot' 'path:Print the managed cache path'
        'help:Show completion management help')
    if (( CURRENT == 2 )); then _describe 'completion operation' actions; return; fi
    case $words[2] in
        list|check|refresh)
            _arguments '--json[Emit structured output]' \
                '--binary[Use an explicit SSMCP executable for check or refresh]:executable:_files -g "*(*)"' \
                '1:operation:(list check refresh)' '2:command:_command_names'
            ;;
        path) _arguments '1:operation:(path)' '--json[Emit structured output]' ;;
        *) return 1 ;;
    esac
}

_omztty_config() {
    local -a actions=(
        'init:Prepare an editable profile' 'plan:Preview configuration deployment'
        'refresh:Update unchanged defaults' 'apply:Deploy the profile'
        'status:Inspect managed files' 'remove:Restore saved originals'
        'path:Print the profile directory' 'audit:Inspect the configuration'
        'sync:Synchronize the profile with Git' 'help:Show configuration help'
    )
    if (( CURRENT == 2 )); then _describe 'configuration action' actions; return; fi
    case $words[2] in
        plan) _arguments '1:action:(plan)' '--json[Emit machine-readable output]' ;;
        apply) _arguments '1:action:(apply)' '--backup[Preserve conflicting files]' ;;
        sync) _arguments '1:action:(sync)' '2:operation:(status pull push init history restore)' ;;
        *) return 1 ;;
    esac
}

_omztty_settings() {
    local group=$words[1] action=${words[2]-} file name value
    local config=${XDG_CONFIG_HOME:-$HOME/.config}/oh-my-ztty
    local -a actions names
    case $group in
        env) actions=('list:List managed names' 'get:Print a managed value' 'set:Save a literal value'
                      'unset:Remove a saved value' 'edit:Edit the data file' 'file:Print the data file path') ;;
        path) actions=('list:List saved PATH rules' 'add:Add a directory' 'remove:Remove a saved rule'
                       'move:Change priority' 'edit:Edit PATH rules' 'file:Print the data file path') ;;
        rc) actions=('init:Prepare shell configuration' 'status:Show locations and reload command'
                     'list:List rc snippets' 'add:Create or import a snippet' 'edit:Edit a snippet'
                     'show:Print a snippet' 'enable:Enable a snippet' 'disable:Disable a snippet'
                     'remove:Remove a snippet' 'file:Print a snippet path' 'check:Validate without executing'
                     'install:Connect an existing zsh rc' 'uninstall:Remove the managed source block'
                     'backups:List saved file versions' 'restore:Restore a saved file version') ;;
    esac
    if (( CURRENT == 2 )); then _describe "$group action" actions; return; fi
    case $group:$action in
        env:list) _arguments '1:action:(list)' '--show[Reveal values]' ;;
        env:set|env:get|env:unset)
            if (( CURRENT == 3 )); then
                for file in "$config/profile/shell/env.tsv" "$config/local/env.tsv"; do
                    [[ -f $file && ! -L $file ]] || continue
                    while IFS=$'\t' read -r name value; do
                        [[ $name == [A-Za-z_]* && $name != *[^A-Za-z0-9_]* ]] && names+=("$name")
                    done < "$file"
                done
                compadd -a names
                [[ $action != set ]] || _message 'environment variable name'
            elif [[ $action == set && CURRENT == 4 ]]; then
                _message 'literal value (quote spaces)'
            elif [[ $action != get ]]; then compadd -- --shared
            fi ;;
        env:edit|env:file) compadd -- --shared ;;
        path:list) compadd -- --effective ;;
        path:add|path:remove|path:move)
            if (( CURRENT == 3 )); then _directories
            elif [[ $action == add ]]; then compadd -- --prepend --append
            elif [[ $action == move ]]; then compadd -- first last
            fi ;;
        rc:install|rc:uninstall) compadd -- --dry-run ;;
        rc:add)
            if (( CURRENT == 3 )); then _message 'snippet name'
            elif [[ $words[CURRENT-1] == --from ]]; then _files
            else compadd -- --from
            fi ;;
        rc:edit|rc:show|rc:enable|rc:disable|rc:remove|rc:file)
            for file in "$config/profile/shell/rc.d"/*.zsh(N) "$config/profile/shell/rc.d"/*.zsh.disabled(N); do
                names+=("${${${file:t}%.disabled}%.zsh}")
            done
            compadd -a names ;;
        rc:restore)
            for file in "${XDG_STATE_HOME:-$HOME/.local/state}/oh-my-ztty/backups"/*(N/); do names+=("${file:t}"); done
            compadd -a names ;;
        *) return 1 ;;
    esac
}

_omztty() {
    local context state state_descr line
    typeset -A opt_args
    local -a commands=(
        'shell:Open the preset zsh' 'terminal:Open ztty with the preset'
        'ai:Use explicit AI actions' 'config:Manage the unified profile'
        'setup:Set up shell settings and private GitHub sync' 'env:Manage environment variables'
        'path:Manage PATH priority' 'rc:Manage shell snippets and backups' 'sync:Synchronize personal configuration'
        'completion:List, check and refresh command completions'
        'dot:Run zdot' 'zdot:Run zdot' 'zshard:Manage shell plugins'
        'ztty:Run ztty' 'ssmcp:Run ssmcp'
        'info:Show system information' 'zfetch:Run zfetch'
        'memory:Manage memory and Swap' 'zmem:Run zmem'
        'doctor:Check dependencies' 'version:Show suite version'
        'update:Update a per-user installation' 'uninstall:Remove a per-user installation'
        'help:Show help'
    )
    if (( CURRENT == 2 )); then
        _arguments '(-h --help)'{-h,--help}'[Show help]' \
            '(-V --version)'{-V,--version}'[Show version]' '1:command:->command'
        [[ $state == command ]] && _describe 'command' commands
        return
    fi
    local command=$words[2]
    local -a words=("$words[@]")
    shift words
    local -i CURRENT=$(( CURRENT - 1 ))
    local service=$command
    local curcontext="$curcontext"
    case $command in
        config) _omztty_config ;;
        env|path|rc) _omztty_settings ;;
        completion|completions) _omztty_completion ;;
        sync)
            if (( CURRENT == 2 )); then _arguments '1:operation:(status pull push init history restore)'
            elif [[ $words[2] == restore && CURRENT == 3 ]]; then _message 'Git commit or revision'
            elif [[ $words[2] == restore && CURRENT == 4 ]]; then _message 'optional profile-relative file'
            fi ;;
        setup) _arguments '(--repo --from)--local[Prepare local configuration only]' \
            '(--local --from)--repo[Create a private repository]:repository name:' \
            '(--local --repo)--from[Restore a private repository]:owner/repository:' \
            '--yes[Confirm the explicitly selected setup mode]' '--install-rc[Install the zsh source block]' ;;
        terminal|ztty)
            # Keep personal ztty completions in the normal dispatch path.
            local omztty_terminal_preset=0
            [[ $command == terminal ]] && omztty_terminal_preset=1
            words[1]=ztty
            service=ztty
            if (( $+_comps[ztty] )); then _normal
            else _omztty_terminal
            fi ;;
        dot|zdot)
            words[1]=zdot
            service=zdot
            if (( $+_comps[zdot] )); then _normal
            else _omztty_zdot
            fi ;;
        info|zfetch)
            words[1]=zfetch
            service=zfetch
            if (( $+_comps[zfetch] )); then _normal
            else
                _arguments '--json[Emit structured information]' '--no-color[Disable color]' \
                    '(-h --help)'{-h,--help}'[Show help]' '(-V --version)'{-V,--version}'[Show version]'
            fi ;;
        memory|zmem)
            if [[ $command == memory && CURRENT == 2 ]]; then
                local -a actions=('status:Show memory status' 'plan:Explain policy decisions'
                    'doctor:Check memory support' 'schema:Describe AI output' 'run:Start a managed workload'
                    'setup:Install the system memory manager' 'rollback:Restore previous managers')
                _describe 'memory action' actions
            else
                words[1]=zmem
                service=zmem
                _normal
            fi ;;
        shell) words[1]=zsh; service=zsh; _normal ;;
        zshard) _normal ;;
        ssmcp)
            local _OMZTTY_COMPLETION_BINARY=$OMZTTY_ROOT/bin/ssmcp
            _normal
            ;;
        ai)
            if (( CURRENT == 2 )); then
                _arguments '1:action:(context connect ask propose help)'
            elif [[ $words[2] == connect ]]; then
                shift words
                (( --CURRENT ))
                words[1]=ssmcp
                service=ssmcp
                local _OMZTTY_COMPLETION_BINARY=$OMZTTY_ROOT/bin/ssmcp
                _normal
            elif [[ $words[2] == (ask|propose) ]]; then
                _message 'request text'
            fi ;;
        update) _arguments '(--no-desktop --config-only)--desktop[Enable the desktop entry]' \
            '(--desktop --config-only)--no-desktop[Disable the desktop entry]' \
            '(--no-memory-manager --config-only)--memory-manager[Enable system memory setup]' \
            '(--memory-manager --config-only)--no-memory-manager[Skip system memory setup]' \
            '(--config-only)--with-config[Also pull personal configuration]' \
            '(--desktop --no-desktop --memory-manager --no-memory-manager --with-config)--config-only[Only pull personal configuration]' ;;
        *) return 1 ;;
    esac
}

_omztty "$@"
