#compdef omztty

autoload -Uz _omztty_zdot _omztty_terminal

_omztty_config() {
    local -a actions=(
        'init:Prepare an editable profile' 'plan:Preview configuration deployment'
        'refresh:Update unchanged defaults' 'apply:Deploy the profile'
        'status:Inspect managed files' 'remove:Restore saved originals'
        'path:Print the profile directory' 'audit:Inspect the configuration'
        'sync:Synchronize the profile with Git' 'help:Show configuration help'
    )
    if (( CURRENT == 2 )); then _describe 'configuration action' actions; return; fi
    case $words[2] in
        plan) _arguments '1:action:(plan)' '--json[Emit machine-readable output]' ;;
        apply) _arguments '1:action:(apply)' '--backup[Preserve conflicting files]' ;;
        sync) _arguments '1:action:(sync)' '2:operation:(status pull push)' ;;
        *) return 1 ;;
    esac
}

_omztty() {
    local context state state_descr line
    typeset -A opt_args
    local -a commands=(
        'shell:Open the preset zsh' 'terminal:Open ztty with the preset'
        'ai:Use explicit AI actions' 'config:Manage the unified profile'
        'dot:Run zdot' 'zdot:Run zdot' 'zshard:Manage shell plugins'
        'ztty:Run ztty' 'ssmcp:Run ssmcp'
        'info:Show system information' 'zfetch:Run zfetch'
        'doctor:Check dependencies' 'version:Show suite version'
        'update:Update a per-user installation' 'uninstall:Remove a per-user installation'
        'help:Show help'
    )
    if (( CURRENT == 2 )); then
        _arguments '(-h --help)'{-h,--help}'[Show help]' \
            '(-V --version)'{-V,--version}'[Show version]' '1:command:->command'
        [[ $state == command ]] && _describe 'command' commands
        return
    fi
    local command=$words[2]
    local -a words=("$words[@]")
    shift words
    local -i CURRENT=$(( CURRENT - 1 ))
    local service=$command
    local curcontext="$curcontext"
    case $command in
        config) _omztty_config ;;
        terminal|ztty)
            # Keep personal ztty completions in the normal dispatch path.
            local omztty_terminal_preset=0
            [[ $command == terminal ]] && omztty_terminal_preset=1
            words[1]=ztty
            service=ztty
            if (( $+_comps[ztty] )); then _normal
            else _omztty_terminal
            fi ;;
        dot|zdot)
            words[1]=zdot
            service=zdot
            if (( $+_comps[zdot] )); then _normal
            else _omztty_zdot
            fi ;;
        info|zfetch)
            words[1]=zfetch
            service=zfetch
            if (( $+_comps[zfetch] )); then _normal
            else
                _arguments '--json[Emit structured information]' '--no-color[Disable color]' \
                    '(-h --help)'{-h,--help}'[Show help]' '(-V --version)'{-V,--version}'[Show version]'
            fi ;;
        shell) words[1]=zsh; service=zsh; _normal ;;
        zshard|ssmcp) _normal ;;
        ai)
            if (( CURRENT == 2 )); then
                _arguments '1:action:(context connect ask propose help)'
            elif [[ $words[2] == connect ]]; then
                shift words
                (( --CURRENT ))
                words[1]=ssmcp
                service=ssmcp
                _normal
            elif [[ $words[2] == (ask|propose) ]]; then
                _message 'request text'
            fi ;;
        update) _arguments '(--no-desktop)--desktop[Enable the desktop entry]' \
            '(--desktop)--no-desktop[Disable the desktop entry]' ;;
        *) return 1 ;;
    esac
}

_omztty "$@"
