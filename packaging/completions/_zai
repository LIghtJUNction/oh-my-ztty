#compdef zai

local context state state_descr line
typeset -A opt_args
if (( CURRENT == 2 )); then
    local -a actions=(
        'context:Print local context' 'connect:Start ssmcp in this directory'
        'ask:Send an explicit request' 'propose:Stage a quoted command for review'
        'help:Show help'
    )
    _arguments -C '(-h --help)'{-h,--help}'[Show help]' '1:action:->action'
    [[ $state == action ]] && _describe 'AI action' actions
    return
fi
case $words[2] in
    connect)
        local -a words=("$words[@]")
        shift words
        local -i CURRENT=$(( CURRENT - 1 ))
        words[1]=ssmcp
        local service=ssmcp curcontext="$curcontext"
        _normal ;;
    ask) _message 'request text' ;;
    propose) _message 'one quoted command' ;;
    *) return 1 ;;
esac
