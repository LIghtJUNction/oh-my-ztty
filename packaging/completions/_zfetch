#compdef zfetch

# Keep the space-separated form when completing the option name.
local format_option='*--format'
[[ $PREFIX$SUFFIX == --format=* ]] && format_option+='='

_arguments \
    '*--json[emit structured system information]' \
    "${format_option}[select text or JSON output]:format:(text json)" \
    '--no-color[disable ANSI color]' \
    '(-h --help)'{-h,--help}'[show help]' \
    '(-V --version)'{-V,--version}'[show version]'
