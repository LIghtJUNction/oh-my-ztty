# Ink: warm graphite, linen and copper. No patched font is required.
font = JetBrains Mono,JetBrainsMono Nerd Font,Caskaydia Mono,Cascadia Mono,monospace:size=13
window-padding = 28
background = #161412
foreground = #e8ded2
background-opacity = 100
background-blur = false
cursor-shape = bar
cursor-color = #d4a373
cursor-blink = false
selection-background = #493b30
selection-foreground = #fff3e5

# ANSI slots retain distinct luminance without introducing blue or green accents.
palette = 0=#26211d
palette = 1=#e59a91
palette = 2=#c9b88a
palette = 3=#dfbf8e
palette = 4=#b7a393
palette = 5=#c5a4b6
palette = 6=#d4a373
palette = 7=#d8ccbd
palette = 8=#a3978b
palette = 9=#efb0a7
palette = 10=#dfd0a5
palette = 11=#f1d5a7
palette = 12=#d0beb0
palette = 13=#dfbfcd
palette = 14=#ebbc93
palette = 15=#fff3e5
