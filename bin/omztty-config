#!/bin/sh
# Explicit, user-scoped configuration deployment through the bundled zdot.
set -eu
umask 077
root=${OMZTTY_ROOT:?run this through omztty config}
config=${XDG_CONFIG_HOME:-"$HOME/.config"}
statehome=${XDG_STATE_HOME:-"$HOME/.local/state"}
profile="$config/oh-my-ztty/profile"
state="$statehome/zdot/oh-my-ztty"
die() { printf 'oh-my-ztty config: %s\n' "$*" >&2; exit 1; }
usage() {
    cat <<'EOF'
Usage: omztty config COMMAND
  init                Copy the bundled Ink defaults into an editable profile
  plan [--json]       Preview the complete home configuration deployment
  refresh             Update unchanged defaults after a suite upgrade
  apply [--backup]    Link the profile through zdot; back up conflicts explicitly
  status              Inspect every managed configuration
  remove              Restore the files saved before adoption
  path                Print the editable profile directory
  audit               Inspect managed files and known retired shell frameworks
  sync status|pull|push  Use zdot's explicit Git synchronization
Personal shell additions live in ~/.config/oh-my-ztty/local.zsh.
Configuration commands do not install applications or start background services.
EOF
}
case "$config:$statehome:$HOME" in *'
'*) die 'paths must not contain a newline' ;; esac
for value in "$config" "$statehome" "$HOME"; do
    case "$value" in /*) ;; *) die 'HOME and XDG paths must be absolute' ;; esac
done
case "$config" in
    "$HOME"/*) config_relative=${config#"$HOME"/} ;;
    *) die 'XDG_CONFIG_HOME must be below HOME for this home deployment' ;;
esac
case "/$config_relative/" in */../*|*/./*) die 'XDG_CONFIG_HOME must not contain dot segments' ;; esac
prepare_profile() {
    defaults_source="$1/components/zrc/profiles/ink"
    defaults_out=$2
    [ -f "$defaults_source/profile.zdot" ] || die 'this bundle does not include zrc defaults'
    mkdir -p -- "$defaults_out"
    cp -R -- "$defaults_source/files" "$defaults_out/files"
    tab=$(printf '\t')
    while IFS="$tab" read -r source destination; do
        case "$source" in ''|'#'*) printf '%s\n' "$source"; continue ;; esac
        case "$destination" in
            .config/*) destination="$config_relative/${destination#.config/}" ;;
        esac
        printf '%s\t%s\n' "$source" "$destination"
    done < "$defaults_source/profile.zdot" > "$defaults_out/profile.zdot"
    cp -- "$1/config/home/.zshrc" "$defaults_out/files/.zshrc"
    mkdir -p -- "$defaults_out/files/.config/ztty"
    cp -- "$1/config/ztty/config" "$defaults_out/files/.config/ztty/config"
    printf 'files/.zshrc\t.zshrc\nfiles/.config/ztty\t%s/ztty\n' "$config_relative" >> "$defaults_out/profile.zdot"
    printf '%s\n' omztty-profile-v1 > "$defaults_out/.omztty-profile"
    cp -- "$1/VERSION" "$defaults_out/.suite-version"
}
baseline_manifest() (
    cd -- "$1" || exit
    find . -type f ! -path ./MANIFEST.sha256 -print | LC_ALL=C sort |
      while IFS= read -r file; do sha256sum -- "$file" || exit; done
)
save_baseline() {
    baseline_source=$1
    baseline_out=$2
    mkdir -- "$baseline_out"
    cp -R -- "$baseline_source/files" "$baseline_out/files"
    cp -- "$baseline_source/profile.zdot" "$baseline_source/.suite-version" "$baseline_out/"
    printf '%s\n' omztty-defaults-v1 > "$baseline_out/.omztty-defaults"
    baseline_manifest "$baseline_out" > "$baseline_out/MANIFEST.sha256"
}
validate_baseline() {
    [ -d "$1" ] && [ ! -L "$1" ] ||
      die 'profile baseline must be an owned directory'
    [ -z "$(find "$1" ! -type d ! -type f -print -quit)" ] ||
      die 'profile baseline contains a link or special file'
    [ -f "$1/.omztty-defaults" ] &&
      [ "$(cat "$1/.omztty-defaults")" = omztty-defaults-v1 ] &&
      [ -f "$1/.suite-version" ] && [ -f "$1/profile.zdot" ] &&
      [ -d "$1/files" ] && [ -f "$1/MANIFEST.sha256" ] ||
      die 'profile baseline is incomplete or unowned'
    [ "$(cat "$1/.suite-version")" = "$2" ] ||
      die 'profile baseline version does not match .suite-version'
    baseline_manifest "$1" | cmp -s "$1/MANIFEST.sha256" - ||
      die 'profile baseline verification failed'
}
regular_profile_file() {
    probe=$1
    while [ "$probe" != "$profile" ]; do
        [ ! -L "$probe" ] || return 1
        probe=${probe%/*}
    done
    [ -f "$1" ]
}
action=${1:-help}
[ "$#" -eq 0 ] || shift
case "$action" in
    help|-h|--help) usage; exit 0 ;;
    path) [ "$#" -eq 0 ] || die 'path takes no arguments'; printf '%s\n' "$profile"; exit 0 ;;
    init)
        [ "$#" -eq 0 ] || die 'init takes no arguments'
        if [ -e "$profile" ] || [ -L "$profile" ]; then
            [ -d "$profile" ] && [ ! -L "$profile" ] &&
              [ "$(cat "$profile/.omztty-profile" 2>/dev/null)" = omztty-profile-v1 ] ||
              die "preserving an existing, unowned profile: $profile"
            printf 'Profile already exists: %s\n' "$profile"
            exit 0
        fi
        mkdir -p -- "$config/oh-my-ztty"
        stage=$(mktemp -d "$config/oh-my-ztty/.profile.XXXXXXXX")
        trap 'rm -rf -- "$stage"' EXIT
        trap 'exit 130' INT
        trap 'exit 143' HUP TERM
        prepare_profile "$root" "$stage"
        save_baseline "$stage" "$stage/.baseline"
        mv -T -- "$stage" "$profile"
        printf 'Prepared %s\nNext: omztty config plan\nApply: omztty config apply --backup\n' "$profile"
        exit 0 ;;
    plan|apply|status|remove|audit|sync|refresh) ;;
    *) usage >&2; exit 2 ;;
esac
[ -d "$profile" ] && [ ! -L "$profile" ] &&
  [ "$(cat "$profile/.omztty-profile" 2>/dev/null)" = omztty-profile-v1 ] ||
  die 'no owned profile; run omztty config init'
case "$action" in
    plan) [ "$#" -eq 0 ] || { [ "$#" -eq 1 ] && [ "$1" = --json ]; } || die 'plan accepts only --json' ;;
    apply) [ "$#" -eq 0 ] || { [ "$#" -eq 1 ] && [ "$1" = --backup ]; } || die 'apply accepts only --backup' ;;
    status|remove|audit|refresh) [ "$#" -eq 0 ] || die "$action takes no arguments" ;;
    sync)
        [ "$#" -eq 1 ] || die 'sync requires status, pull, or push'
        case "$1" in status|pull|push) ;; *) die 'sync requires status, pull, or push' ;; esac
        exec "$root/bin/zdot" sync --root "$profile" "$1" ;;
esac
if [ "$action" = refresh ]; then
    [ -f "$profile/.suite-version" ] && [ ! -L "$profile/.suite-version" ] ||
      die 'profile has no regular .suite-version baseline'
    previous=$(cat "$profile/.suite-version")
    version=$(cat "$root/VERSION")
    for value in "$previous" "$version"; do
        printf '%s\n' "$value" | LC_ALL=C grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$' ||
          die 'profile and suite versions must be stable semantic versions'
    done
    stored_baseline=0
    if [ -e "$profile/.baseline" ] || [ -L "$profile/.baseline" ]; then
        validate_baseline "$profile/.baseline" "$previous"
        stored_baseline=1
    fi
    if [ "$previous" = "$version" ]; then
        printf 'Profile baseline is already suite %s.\n' "$version"
        exit 0
    fi
    if [ "$stored_baseline" -eq 0 ]; then
        releases=${root%/*}
        base=${releases%/*}
        [ "${releases##*/}" = releases ] &&
          [ "$(cat "$base/.owner" 2>/dev/null)" = oh-my-ztty-v1 ] ||
          die 'profile has no saved baseline; its original installed release is required'
        platform=$(cat "$root/PLATFORM")
        case "$platform" in linux-x86_64|linux-aarch64) ;; *) die 'unsupported suite platform' ;; esac
        baseline="$releases/$previous-$platform"
        [ -d "$baseline" ] && [ ! -L "$baseline" ] &&
          [ -f "$baseline/MANIFEST.sha256" ] ||
          die "baseline release $previous is unavailable; restore that installed release before refreshing"
        (cd "$baseline" && sha256sum --quiet -c MANIFEST.sha256) ||
          die "release defaults were modified: $baseline"
    fi
    (cd "$root" && sha256sum --quiet -c MANIFEST.sha256) ||
      die "release defaults were modified: $root"
    stage=$(mktemp -d "$config/oh-my-ztty/.refresh.XXXXXXXX")
    cleanup_refresh() {
        # Keep the recorded version and baseline paired if publication fails.
        if [ "$(cat "$profile/.suite-version" 2>/dev/null)" != "$version" ]; then
            if [ -d "$stage/previous-baseline" ]; then
                if [ -d "$profile/.baseline" ]; then
                    mv -T -- "$profile/.baseline" "$stage/uncommitted-baseline" || return
                fi
                mv -T -- "$stage/previous-baseline" "$profile/.baseline" || return
            elif [ "$stored_baseline" -eq 0 ] && [ -d "$profile/.baseline" ]; then
                mv -T -- "$profile/.baseline" "$stage/uncommitted-baseline" || return
            fi
        fi
        rm -rf -- "$stage"
    }
    trap cleanup_refresh EXIT
    trap 'exit 130' INT
    trap 'exit 143' HUP TERM
    if [ "$stored_baseline" -eq 1 ]; then
        cp -R -- "$profile/.baseline" "$stage/old"
    else
        prepare_profile "$baseline" "$stage/old"
    fi
    prepare_profile "$root" "$stage/new"
    save_baseline "$stage/new" "$stage/baseline"
    (cd "$stage/old" && find files -type f -print | LC_ALL=C sort) > "$stage/old-files"
    (cd "$stage/new" && find files -type f -print | LC_ALL=C sort) > "$stage/new-files"
    cmp -s "$stage/old-files" "$stage/new-files" &&
      cmp -s "$stage/old/profile.zdot" "$stage/new/profile.zdot" ||
      die 'default file layout changed; review the new profile before refreshing'
    : > "$stage/updates"
    updated=0
    preserved=0
    while IFS= read -r relative; do
        old="$stage/old/$relative"
        new="$stage/new/$relative"
        destination="$profile/$relative"
        cmp -s "$old" "$new" && continue
        # Never traverse a user-replaced directory or overwrite a source symlink.
        if regular_profile_file "$destination"; then
            cmp -s "$new" "$destination" && continue
            if cmp -s "$old" "$destination"; then
                replacement="$stage/updates.d/$relative"
                mkdir -p -- "${replacement%/*}"
                cp -p -- "$destination" "$replacement"
                chmod u+w -- "$replacement"
                cat -- "$new" > "$replacement"
                chmod --reference="$destination" -- "$replacement"
                printf '%s\n' "$relative" >> "$stage/updates"
                continue
            fi
        fi
        printf 'preserved %s\n' "$relative"
        preserved=$((preserved + 1))
    done < "$stage/new-files"
    while IFS= read -r relative; do
        destination="$profile/$relative"
        if regular_profile_file "$destination" && cmp -s "$stage/old/$relative" "$destination"; then
            mv -Tf -- "$stage/updates.d/$relative" "$destination"
            printf 'updated   %s\n' "$relative"
            updated=$((updated + 1))
        else
            printf 'preserved %s (changed during refresh)\n' "$relative"
            preserved=$((preserved + 1))
        fi
    done < "$stage/updates"
    cp -p -- "$profile/.suite-version" "$stage/version"
    chmod u+w -- "$stage/version"
    printf '%s\n' "$version" > "$stage/version"
    chmod --reference="$profile/.suite-version" -- "$stage/version"
    if [ "$stored_baseline" -eq 1 ]; then
        mv -T -- "$profile/.baseline" "$stage/previous-baseline"
    fi
    mv -T -- "$stage/baseline" "$profile/.baseline"
    mv -Tf -- "$stage/version" "$profile/.suite-version"
    printf 'Refreshed defaults from %s to %s: %s updated, %s preserved.\n' "$previous" "$version" "$updated" "$preserved"
    printf 'Existing mappings, deployment backups and personal additions were preserved.\n'
    exit 0
fi
if [ "$action" = audit ]; then
    "$root/bin/zdot" status --root "$profile" --target "$HOME" --state-dir "$state"
    printf '\nKnown legacy shell locations:\n'
    count=0
    for name in .oh-my-zsh .zim .zimrc .zinit .zplug .zprezto .p10k.zsh .config/starship.toml .local/share/zinit .local/share/antidote; do
        if [ -e "$HOME/$name" ] || [ -L "$HOME/$name" ]; then
            printf 'review  %s\n' "$HOME/$name"
            count=$((count + 1))
        fi
    done
    [ "$count" -ne 0 ] || printf 'No known legacy shell locations remain.\n'
    exit 0
fi
exec "$root/bin/zdot" "$action" --root "$profile" --target "$HOME" --state-dir "$state" "$@"
