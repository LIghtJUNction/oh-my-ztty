#!/bin/sh
set -eu
self=$(readlink -f -- "$0")
root=${self%/*}
root=${root%/*}
export OMZTTY_ROOT="$root"
usage() {
    cat <<'EOF'
oh-my-ztty — a lean terminal workspace
Usage: omztty COMMAND [ARGS...]
  shell       Open the preset zsh (accepts zsh arguments)
  terminal    Open ztty with the preset zsh (accepts ztty options)
  ai          Connect this directory through bundled ssmcp
  config      Manage the unified zrc profile through zdot
  setup       Set up shell settings and optional private GitHub sync
  env         Manage local or shared environment variables
  path        Manage ordered PATH entries
  rc          Manage zsh snippets, startup hooks and backups
  sync        Synchronize your private configuration repository
  dot         Run bundled zdot
  zshard      Manage shell plugins
  ztty|ssmcp  Run a bundled component directly
  info        Show the lightweight native system overview
  memory      Manage memory and Swap through zmem
  doctor      Check installed components and system dependencies
  version     Show the suite version
  update      Update suite [--with-config] or only config [--config-only]
  uninstall   Remove suite-owned files and links
zmem manages system memory after installation. AI connections start on request.
EOF
}
case "${1:-help}" in
    -h|--help|help) usage; exit 0 ;;
    -V|--version|version) printf 'oh-my-ztty %s\n' "$(cat "$root/VERSION")"; exit 0 ;;
esac
cmd=$1; shift
suite_socket() {
    if [ -n "${OMZTTY_SOCKET:-}" ]; then
        export ZTTY_SOCKET="$OMZTTY_SOCKET"
    else
        IFS= read -r version < "$root/VERSION"
        export ZTTY_SOCKET="@oh-my-ztty-$(id -u)-$version"
    fi
}
terminal_needs_default_shell() {
    # Match the pinned ztty option arity without consuming its command arguments.
    # In particular, a value such as --name '-e' is not an execution boundary.
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --config|--name|--cwd|--font|--geometry|--scrollback|--tab|--split-right|--split-down|--backend|--text-plugin)
                [ "$#" -ge 2 ] || return 1
                shift 2 ;;
            --observe) shift ;;
            -e|--|--help|-h|--version|-V) return 1 ;;
            # Let ztty diagnose unknown arguments and missing option values.
            *) return 1 ;;
        esac
    done
    return 0
}
case "$cmd" in
    shell|terminal)
        command -v zsh >/dev/null 2>&1 || { printf 'zsh is required\n' >&2; exit 1; }
        export PATH="$root/bin:$PATH"
        export OMZTTY_USER_ZDOTDIR="${OMZTTY_USER_ZDOTDIR-${ZDOTDIR-$HOME}}"
        export ZDOTDIR="$root/config/zsh"
        export ZSHARD_HOME="$root/components/zshard"
        export ZSHARD_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/oh-my-ztty/zshard/${root##*/}"
        state="${XDG_STATE_HOME:-$HOME/.local/state}/oh-my-ztty"
        [ -d "$state" ] || (umask 077; mkdir -p -- "$state")
        export HISTFILE="$state/history"
        if [ "$cmd" = shell ]; then exec zsh -d "$@"; fi
        suite_socket
        if terminal_needs_default_shell "$@"; then
            set -- "$@" -e "$root/bin/omztty" shell
        fi
        exec "$root/bin/ztty" --config "$root/config/ztty/config" "$@" ;;
    ai)
        export PATH="$root/bin:$PATH"
        export ZSHARD_HOME="$root/components/zshard"
        action=${1:-help}
        [ "$#" -eq 0 ] || shift
        case "$action" in
            context) exec "$root/components/zshard/bin/zshard" ai context "$@" ;;
            ask) exec "$root/bin/omztty" shell -i -c 'zai ask "$@"' omztty-ai "$@" ;;
            connect) exec "$root/bin/ssmcp" "$@" ;;
            propose) printf 'Open omztty shell, then use: zai propose "command"\nThe proposal is placed in the editable buffer for review.\n'; exit 2 ;;
            help|-h|--help) printf 'Usage: omztty ai context | connect [ssmcp options] | ask TEXT\nContext is local JSON; connect starts ssmcp explicitly.\n' ;;
            *) printf 'Unknown AI action: %s\n' "$action" >&2; exit 2 ;;
        esac ;;
    info|zfetch) exec "$root/bin/zfetch" "$@" ;;
    zmem) exec "$root/bin/zmem" "$@" ;;
    memory)
        action=${1:-status}
        [ "$#" -eq 0 ] || shift
        case "$action" in
            setup|rollback)
                [ "$#" -eq 0 ] || { printf 'usage: omztty memory %s\n' "$action" >&2; exit 2; }
                if [ "$action" = setup ]; then
                    set -- "$root/bin/zmem" install --replace --config "$root/config/zmem/zmem.conf"
                else
                    set -- /usr/local/bin/zmem rollback
                fi
                if [ "$(id -u)" -eq 0 ]; then exec "$@"; fi
                command -v sudo >/dev/null 2>&1 || { printf 'sudo is required for system memory setup\n' >&2; exit 1; }
                exec sudo -- "$@" ;;
            *) exec "$root/bin/zmem" "$action" "$@" ;;
        esac ;;
    ssmcp) exec "$root/bin/ssmcp" "$@" ;;
    config) exec sh "$root/bin/omztty-config" "$@" ;;
    env|path|rc) exec zsh -df "$root/bin/omztty-manage" "$cmd" "$@" ;;
    setup|sync) exec zsh -df "$root/bin/omztty-$cmd" "$@" ;;
    dot|zdot) exec "$root/bin/zdot" "$@" ;;
    zshard) exec "$root/components/zshard/bin/zshard" "$@" ;;
    ztty) suite_socket; exec "$root/bin/ztty" "$@" ;;
    doctor)
        failed=0
        printf 'oh-my-ztty %s\n' "$(cat "$root/VERSION")"
        for tool in zsh git; do
            if command -v "$tool" >/dev/null 2>&1; then printf 'ok   system %s\n' "$tool"; else printf 'miss system %s\n' "$tool"; failed=1; fi
        done
        for tool in ztty ssmcp zdot zfetch zmem; do
            if version_output=$("$root/bin/$tool" --version 2>&1); then
                printf 'ok   %s\n' "$version_output"
            else
                printf 'fail bundled %s\n%s\n' "$tool" "$version_output"
                failed=1
            fi
        done
        if [ -f "$root/components/zshard/zshard.zsh" ]; then printf 'ok   zshard\n'; else printf 'miss zshard\n'; failed=1; fi
        if [ -n "${DISPLAY:-}" ]; then printf 'ok   X11/XWayland display configured\n'; else printf 'info no DISPLAY; shell and AI commands still work\n'; fi
        if [ "$(uname -s)" = Linux ] && command -v systemctl >/dev/null 2>&1; then
            if systemctl is-active --quiet zmem.service 2>/dev/null; then
                printf 'ok   zmem system memory manager active\n'
            else
                printf 'info zmem service inactive or unavailable; setup: omztty memory setup\n'
            fi
        else
            printf 'info zmem service requires Linux with systemd\n'
        fi
        printf 'No connection or background service was started.\n'
        exit "$failed" ;;
    update)
        config_only=0
        with_config=0
        desktop_option=
        memory_option=
        for option in "$@"; do
            case "$option" in
                --config-only) config_only=1 ;;
                --with-config) with_config=1 ;;
                --desktop|--no-desktop) desktop_option=$option ;;
                --memory-manager|--no-memory-manager) memory_option=$option ;;
                *) printf 'usage: omztty update [--desktop | --no-desktop] [--memory-manager | --no-memory-manager] [--with-config] | --config-only\n' >&2; exit 2 ;;
            esac
        done
        if [ "$config_only" -eq 1 ]; then
            [ "$with_config" -eq 0 ] && [ -z "$desktop_option" ] && [ -z "$memory_option" ] || {
                printf '%s\n' '--config-only cannot be combined with suite update options' >&2; exit 2;
            }
            exec zsh -df "$root/bin/omztty-sync" pull
        fi
        if [ -f "$root/PACKAGE_MANAGER" ]; then
            printf 'This installation is managed by pacman.\nUpdate with: yay -Syu oh-my-ztty-bin\n' >&2
            exit 2
        fi
        # Reject local config conflicts before spending time on a suite download.
        if [ "$with_config" -eq 1 ]; then zsh -df "$root/bin/omztty-sync" pull; fi
        tmp=$(mktemp -d "${TMPDIR:-/tmp}/oh-my-ztty-update.XXXXXXXX")
        trap 'rm -rf -- "$tmp"' EXIT
        trap 'exit 130' INT
        trap 'exit 143' HUP TERM
        url=https://github.com/LIghtJUNction/oh-my-ztty/releases/latest/download
        curl --fail --silent --show-error --location --proto '=https' --tlsv1.2 "$url/install.sh" -o "$tmp/install.sh"
        curl --fail --silent --show-error --location --proto '=https' --tlsv1.2 "$url/install.sh.sha256" -o "$tmp/install.sh.sha256"
        (cd "$tmp" && sha256sum -c install.sh.sha256)
        base=$(CDPATH= cd -- "$root/../.." && pwd -P)
        [ -f "$base/.owner" ] || { printf 'Update requires an installed suite\n' >&2; exit 1; }
        set --
        [ -z "$desktop_option" ] || set -- "$@" "$desktop_option"
        [ -z "$memory_option" ] || set -- "$@" "$memory_option"
        XDG_DATA_HOME=$(dirname -- "$base") OMZTTY_BIN_DIR=$(cat "$base/.bin-dir") sh "$tmp/install.sh" "$@" ;;
    uninstall)
        if [ -f "$root/PACKAGE_MANAGER" ]; then
            printf 'This installation is managed by pacman.\nRemove with: sudo pacman -R oh-my-ztty-bin\n' >&2
            exit 2
        fi
        [ "$#" -eq 0 ] || { printf 'usage: omztty uninstall\n' >&2; exit 2; }
        base=$(CDPATH= cd -- "$root/../.." && pwd -P)
        exec sh "$root/uninstall.sh" --root "$base" ;;
    *) printf 'Unknown command: %s\n' "$cmd" >&2; usage >&2; exit 2 ;;
esac
